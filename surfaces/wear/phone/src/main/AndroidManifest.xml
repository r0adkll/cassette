<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- A watch asking for a refresh (decision 0013). -->
        <service
            android:name="com.r0adkll.cassette.surfaces.wear.phone.WearRequestService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/cassette/request-refresh"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
