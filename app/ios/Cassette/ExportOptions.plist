<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CI's TestFlight upload (decision 0017): exporting the archive uploads it to App Store Connect. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>N6RWL4DC5S</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- CI sets the build number (the commit count, like Android's); don't let Apple bump it. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
