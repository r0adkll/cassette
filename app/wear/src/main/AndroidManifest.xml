<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:name=".WearApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Needs the phone: it shows the phone's data (decision 0013). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".WearActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The tile (decision 0013): the default bike, and Refresh. -->
        <service
            android:name=".tile.BikeTileService"
            android:description="@string/tile_description"
            android:exported="true"
            android:icon="@drawable/lucide_bike"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- Complications (decision 0013): a bike's weakest component and status, or the component
             picked when it went on the face (decision 0027). -->
        <service
            android:name=".complication.BikeComplicationService"
            android:exported="true"
            android:icon="@drawable/lucide_bike"
            android:label="@string/complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT" />
            <!-- Pushed when the phone sends data; hourly too, so "not seen" arrives on time. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="3600" />
            <!-- Picking the bike and component when it goes on a face (decision 0027). A face's
                 own default slot skips it: the default bike, the weakest component. -->
            <meta-data
                android:name="android.support.wearable.complications.PROVIDER_CONFIG_ACTION"
                android:value="com.r0adkll.cassette.wear.CONFIGURE_COMPLICATION" />
            <meta-data
                android:name="androidx.watchface.complications.datasource.DEFAULT_CONFIG_SUPPORTED"
                android:value="true" />
        </service>

        <activity
            android:name=".complication.ComplicationConfigActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="com.r0adkll.cassette.wear.CONFIGURE_COMPLICATION" />
                <category android:name="android.support.wearable.complications.category.PROVIDER_CONFIG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The phone sent new data: update the tile and complications. -->
        <service
            android:name=".data.PhoneDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/cassette"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
