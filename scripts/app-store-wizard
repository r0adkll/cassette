}

# ── 14 ────────────────────────────────────────────────────────────────────
s_version_page() {
  stage "The version page"
  open_url "$(app_url)"
  step "iOS App → $VERSION Prepare for Submission (sidebar), then on that page:"
  step "Copyright: the year and your name, e.g. 2026 Your Name."
  step "App Review Information: sign-in not required; your name, phone and email."
  step "App Review Information → Attachment: the video of the app reading a real bike."
  step "App Store Version Release: Manually release this version."
  note "The notes and screenshots came with the listing. The build is picked at the end."
  pause "Press Enter once it's saved."
}

# ── 15 ────────────────────────────────────────────────────────────────────
s_release() {
  stage "Release $VERSION"
  say "The store build is the release commit's. scripts/release (decision 0019) rolls the"
  say "changelog into $VERSION, pushes main and tags it, and CI's TestFlight job uploads"
  say "that commit; then it moves main on to the next version."
  note "Merge the listing changes into main first if they're still on a branch."
  printf '\n'
  local sha="" run="" tries
  sha=$(gh api "repos/{owner}/{repo}/commits/$VERSION" --jq .sha 2>/dev/null || true)
  if [[ -n "$sha" ]]; then
    step "$VERSION is released already."
  elif [[ "$(git rev-parse --abbrev-ref HEAD)" == main ]] &&
    confirm "Run scripts/release now? It asks before each step it publishes."; then
    if ! scripts/release; then
      warn "The release stopped; it says how to carry on."
      resume_hint s_release
      exit 1
    fi
  else
    say "In the main checkout: scripts/release"
    pause "Press Enter once $VERSION is released."
  fi
  sha=$(gh api "repos/{owner}/{repo}/commits/$VERSION" --jq .sha 2>/dev/null || true)
  if [[ -z "$sha" ]]; then
    warn "GitHub has no $VERSION tag yet."
    resume_hint s_release
    exit 1
  fi
  # CI's run on the release commit can take a moment to appear.
  for tries in 1 2 3 4 5 6; do
    run=$(gh run list --workflow build.yml --commit "$sha" --event push --limit 1 \
      --json databaseId --jq '.[0].databaseId' 2>/dev/null || true)
    [[ -n "$run" ]] && break
    sleep 10
  done
  if [[ -z "$run" ]]; then
    warn "No CI run for the release commit ($sha) yet: gh run list --commit $sha"
  else
    say "Watching CI on the release commit (run $run); the TestFlight job comes last."
    gh run watch "$run" --exit-status --interval 30 ||
      warn "CI failed on the release commit: gh run view $run --log-failed"
  fi
  # scripts/release made the commit here, as a rule; fetch it otherwise.
  git cat-file -e "$sha" 2>/dev/null || git fetch --quiet origin "$sha" 2>/dev/null || true
  RELEASE_BUILD=$(git rev-list --count --first-parent "$sha" 2>/dev/null || true)
  if [[ -n "$RELEASE_BUILD" ]]; then
    write_env RELEASE_BUILD "$RELEASE_BUILD"
    step "The release build is $VERSION ($RELEASE_BUILD)."
  fi
  pause
}

# ── 16 ────────────────────────────────────────────────────────────────────
s_submit() {
  stage "Submit for review"
  local build="the release commit's build"
  [[ -n "$RELEASE_BUILD" ]] && build="build $RELEASE_BUILD"
  open_url "$(app_url)"
  step "Wait for the release build to finish processing (TestFlight; Apple emails)."
  step "$VERSION Prepare for Submission → Build → + → $build."
  step "Add for Review → Submit to App Review."
  printf '\n'
  note "Review usually takes a day or two, and Apple emails at each step. A rejection comes with"
  note "notes in App Review: reply there, or fix it and cut the next version, renaming this"
  note "App Store version to match before picking its build."
  note "If they ask about SRAM's name (guideline 5.2): the app only says it works with their"
  note "parts, and the listing says it's unofficial and unaffiliated."
  pause "Press Enter once it's submitted."
  printf '\n'
  say "Once it's approved: the version page → Release This Version."
}

banner "Cassette: the App Store"
local i
for i in "${!STAGES[@]}"; do
  if (( i + 1 < FROM )); then
    _STAGE_INDEX=$((_STAGE_INDEX + 1))
    continue
  fi
  "${STAGES[$i]}"
done

finish
}

run_wizard "$@"; exit
