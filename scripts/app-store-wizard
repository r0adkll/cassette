#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────

run_wizard() {

# Cassette on the App Store (decisions 0017 and 0019): the App Store Connect app, the API key CI's
# TestFlight job uploads with, internal testing, the listing, the release and App Review. It spans
# days, so `scripts/app-store-wizard <stage>` resumes at a stage. Values live outside the repo, in a
# 0600 env file.
cd "$(dirname "$0")/.."
ENV_FILE="$HOME/.cassette/app-store.env"
KEY_JSON="$HOME/.cassette/app-store-connect.json"
APP_ID=com.r0adkll.cassette
ASC=https://appstoreconnect.apple.com
NAME_FILE=fastlane/metadata/ios/en-US/name.txt
STORE_NAME=$(head -n1 "$NAME_FILE")
mkdir -p "$(dirname "$ENV_FILE")"
chmod 700 "$(dirname "$ENV_FILE")"

# Saved by earlier runs, so a resumed run has them. The version is kept rather than read again:
# scripts/release moves cassette.version on before the last stage.
VERSION=$(_existing APP_STORE_VERSION || sed -n 's/^cassette\.version=//p' gradle.properties)
ASC_APP_ID=$(_existing ASC_APP_ID || true)
APP_STORE_CONNECT_KEY_ID=$(_existing APP_STORE_CONNECT_KEY_ID || true)
APP_STORE_CONNECT_ISSUER_ID=$(_existing APP_STORE_CONNECT_ISSUER_ID || true)
APP_STORE_CONNECT_KEY_PATH=$(_existing APP_STORE_CONNECT_KEY_PATH || true)
RELEASE_BUILD=$(_existing RELEASE_BUILD || true)

STAGES=(s_start s_agreements s_bundle_id s_app_record s_api_key s_keep_key s_secrets
  s_first_build s_testers s_try_it s_listing s_privacy s_app_info s_version_page s_release
  s_submit)
TOTAL_STAGES=${#STAGES[@]}

FROM=${1:-1}
if ! [[ "$FROM" =~ ^[0-9]+$ ]] || (( FROM < 1 || FROM > TOTAL_STAGES )); then
  printf 'Usage: scripts/app-store-wizard [stage, 1 to %s]\n' "$TOTAL_STAGES"
  exit 1
fi

# The number a stage has, for "resume at" hints.
stage_number() {
  local i
  for i in "${!STAGES[@]}"; do
    [[ "${STAGES[$i]}" == "$1" ]] && { printf '%s' $((i + 1)); return; }
  done
}

resume_hint() { note "Resume here later: scripts/app-store-wizard $(stage_number "$1")"; }

# The app's page in App Store Connect (My Apps until the app exists).
app_url() { printf '%s/apps/%s' "$ASC" "$ASC_APP_ID"; }

# A path pasted or dragged in from Finder: no trailing space, quotes or escaped spaces.
clean_path() {
  local p="$1" q="'"
  p="${p%"${p##*[![:space:]]}"}"
  p="${p#"$q"}"
  p="${p%"$q"}"
  p="${p//\\ / }"
  printf '%s' "${p/#\~/$HOME}"
}

# The TestFlight job's commands, run here: the fallback when CI can't sign or upload.
archive_here() {
  local out=build/app-store build log xcode
  build=$(git rev-list --count --first-parent HEAD)
  log="$out/archive.log"
  if ! xcodebuild -showsdks 2>/dev/null | grep -q watchos; then
    warn "Xcode's watchOS platform is missing: xcodebuild -downloadPlatform watchOS"
    return 1
  fi
  [[ -f app/ios/Cassette/Firebase/GoogleService-Info.plist ]] ||
    warn "No Firebase config here, so this build won't send crash reports (scripts/firebase-wizard)."
  xcode=$(xcodebuild -version | sed -n 's/^Xcode //p')
  [[ "$(printf '%s\n' 27.1 "$xcode" | sort -V | head -n1)" == 27.1 ]] ||
    warn "This is Xcode $xcode: its build runs letterboxed on the iPhone Duo (CI's has 27.1)."
  mkdir -p "$out"
  local auth=(-allowProvisioningUpdates
    -authenticationKeyPath "$APP_STORE_CONNECT_KEY_PATH"
    -authenticationKeyID "$APP_STORE_CONNECT_KEY_ID"
    -authenticationKeyIssuerID "$APP_STORE_CONNECT_ISSUER_ID")
  say "Archiving build $build from $(git rev-parse --short HEAD); the output goes to $log."
  note "Gradle builds the Kotlin framework first: allow 10 minutes or more."
  if scripts/xcodegen > "$log" 2>&1 &&
    xcodebuild -project app/ios/Cassette/Cassette.xcodeproj -scheme Cassette \
      -configuration Release -destination 'generic/platform=iOS' \
      -archivePath "$out/Cassette.xcarchive" "${auth[@]}" \
      CURRENT_PROJECT_VERSION="$build" archive >> "$log" 2>&1 &&
    xcodebuild -exportArchive -archivePath "$out/Cassette.xcarchive" \
      -exportOptionsPlist app/ios/Cassette/ExportOptions.plist \
      -exportPath "$out/export" "${auth[@]}" >> "$log" 2>&1; then
    step "Uploaded build $build. Apple processes it for 10 to 30 minutes, then emails you."
    note "CI's build of this same commit would be refused as a duplicate; the next commit's is fine."
  else
    warn "It failed. The end of $log:"
    tail -n 20 "$log"
    return 1
  fi
}

# A Release build with Xcode's own account, stopped once signing has passed: automatic signing
# registers every bundle ID and App Group the targets need. CI's API key can't (the first
# TestFlight run failed with "Authentication failed" on the IDs it had to register).
register_ids() {
  local out=build/app-store log pid
  log="$out/register.log"
  mkdir -p "$out"
  if ! xcodebuild -showsdks 2>/dev/null | grep -q watchos; then
    warn "Xcode's watchOS platform is missing: xcodebuild -downloadPlatform watchOS"
    return 1
  fi
  scripts/xcodegen > "$log" 2>&1 || { warn "xcodegen failed: see $log"; return 1; }
  xcodebuild -project app/ios/Cassette/Cassette.xcodeproj -scheme Cassette \
    -configuration Release -destination 'generic/platform=iOS' \
    -derivedDataPath "$out/DerivedData" -allowProvisioningUpdates build >> "$log" 2>&1 &
  pid=$!
  # Signing comes before any build step, so the first CreateBuildDirectory means it passed.
  until grep -qE '^CreateBuildDirectory|^\*\* BUILD' "$log" || ! kill -0 "$pid" 2>/dev/null; do
    sleep 2
  done
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  if grep -q '^CreateBuildDirectory' "$log"; then
    step "Signed: the bundle IDs and the App Group are registered."
  else
    warn "Signing failed. From $log:"
    grep 'error:' "$log" | tail -n 10 || true
    return 1
  fi
}

# ── 1 ─────────────────────────────────────────────────────────────────────
s_start() {
  stage "Before you start"
  say "This puts Cassette on the App Store: the app in App Store Connect, the API key CI"
  say "uploads TestFlight builds with, testing on your bike, the listing, then the release"
  say "and App Review. It takes days end to end; stop whenever you like and resume at a"
  say "stage with scripts/app-store-wizard <stage>."
  printf '\n'
  local missing=() tool
  for tool in gh git python3 xcodebuild; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
  done
  if (( ${#missing[@]} )); then
    warn "Missing: ${missing[*]}. Install them and run this again."
    exit 1
  fi
  if ! gh auth status >/dev/null 2>&1; then
    warn "gh isn't signed in: run gh auth login, then this again."
    exit 1
  fi
  step "gh is signed in; git, python3 and Xcode ($(xcodebuild -version | head -n1)) are here."
  if command -v fastlane >/dev/null 2>&1; then
    step "fastlane is here (it uploads the listing)."
  elif command -v brew >/dev/null 2>&1 && confirm "fastlane uploads the listing. Install it with Homebrew now?"; then
    brew install fastlane
  else
    warn "No fastlane: install it (brew install fastlane) before the listing stage."
  fi
  printf '\n'
  say "The first App Store version is the one main builds now, cassette.version."
  ask APP_STORE_VERSION "Version to ship (Enter for $VERSION):" || true
  APP_STORE_VERSION="${APP_STORE_VERSION:-$VERSION}"
  write_env APP_STORE_VERSION "$APP_STORE_VERSION"
  VERSION=$APP_STORE_VERSION
  note "Values go to $ENV_FILE (mode 0600), never into the repo."
  pause
}

# ── 2 ─────────────────────────────────────────────────────────────────────
s_agreements() {
  stage "Agreements and EU trader status"
  open_url "https://developer.apple.com/account"
  step "Accept the Program License Agreement if a banner asks: uploads fail until you do."
  open_url "$ASC/business"
  step "Business: accept any agreement waiting there. A free app needs no paid agreement."
  step "Set your trader status for the EU's Digital Services Act; Apple doesn't offer the app"
  say "  in the EU without one. A trader's address, phone and email show on the EU listing."
  pause "Press Enter once both pages are clear."
}

# ── 3 ─────────────────────────────────────────────────────────────────────
s_bundle_id() {
  stage "Register the bundle IDs"
  say "App Store Connect only offers bundle IDs that are registered already, and CI's API key"
  say "can't register them. Xcode registers them from this Mac, each with the App Group:"
  note "$APP_ID, .widgets, .watchkitapp, .watchkitapp.widgets and group.$APP_ID."
  step "Xcode → Settings → Accounts: your Apple ID is there, with the team N6RWL4DC5S."
  pause "Press Enter to sign a Release build. It stops once signing passes (a minute or two)."
  until register_ids; do
    confirm "Try again?" || exit 1
  done
  pause
}

# ── 4 ─────────────────────────────────────────────────────────────────────
s_app_record() {
  stage "Create the app in App Store Connect"
  open_url "$ASC/apps"
  step "+ → New App:"
  step "Platforms: iOS. Name: $STORE_NAME"
  step "Primary language: English (U.S.). Bundle ID: $APP_ID (Xcode names it XC com r0adkll cassette)"
  step "SKU: cassette. User access: Full Access. Create."
  note "The watch app ships inside the iOS app, so there's no watchOS platform to tick."
  printf '\n'
  if ! confirm "Did it take the name \"$STORE_NAME\"?"; then
    say "Names are unique on the App Store. The backup was Cassette: Bike Batteries."
    until ask STORE_NAME "The name it took:" || exit 1; (( ${#STORE_NAME} > 0 && ${#STORE_NAME} <= 30 )); do
      warn "App Store names are at most 30 characters."
    done
    printf '%s\n' "$STORE_NAME" > "$NAME_FILE"
    step "Wrote it to $NAME_FILE."
    note "Match Play's title (fastlane/metadata/android/en-US/title.txt) and decision 0019."
  fi
  printf '\n'
  say "App Information (in the sidebar) shows the app's Apple ID, a number."
  until ask ASC_APP_ID "Apple ID:" || exit 1; [[ "$ASC_APP_ID" =~ ^[0-9]+$ ]]; do
    warn "It's all digits."
  done
  write_env ASC_APP_ID "$ASC_APP_ID"
  note "Firebase takes it too: Project settings → Your apps → the iOS app → App Store ID."
  pause
}

# ── 5 ─────────────────────────────────────────────────────────────────────
s_api_key() {
  stage "Create the App Store Connect API key"
  say "CI's TestFlight job signs and uploads with it; fastlane uploads the listing with it."
  open_url "$ASC/access/integrations/api"
  step "Users and Access → Integrations → App Store Connect API → Team Keys."
  step "The first time, Request Access (the Account Holder does this) and accept the terms."
  step "Generate API Key (+): name it Cassette CI, with Admin access."
  note "Admin: automatic signing creates the distribution certificate and profiles with it."
  printf '\n'
  until ask APP_STORE_CONNECT_ISSUER_ID "Issuer ID (above the keys):" || exit 1;
    [[ "$APP_STORE_CONNECT_ISSUER_ID" =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]]; do
    warn "It's a UUID: 8-4-4-4-12 lowercase hex digits."
  done
  until ask APP_STORE_CONNECT_KEY_ID "Key ID (in the new key's row):" || exit 1;
    [[ "$APP_STORE_CONNECT_KEY_ID" =~ ^[A-Z0-9]{10}$ ]]; do
    warn "It's 10 capital letters and digits."
  done
  write_env APP_STORE_CONNECT_ISSUER_ID "$APP_STORE_CONNECT_ISSUER_ID"
  write_env APP_STORE_CONNECT_KEY_ID "$APP_STORE_CONNECT_KEY_ID"
  pause
}

# ── 6 ─────────────────────────────────────────────────────────────────────
s_keep_key() {
  stage "Keep the key"
  local key="$HOME/.cassette/AuthKey_$APP_STORE_CONNECT_KEY_ID.p8" download=""
  if [[ -f "$key" ]]; then
    step "Keeping the key already at $key."
  else
    step "Download the key from its row. Apple lets you download it once only."
    pause "Press Enter once it's downloaded."
    download="$HOME/Downloads/AuthKey_$APP_STORE_CONNECT_KEY_ID.p8"
    until [[ -f "$download" ]] && grep -q 'BEGIN PRIVATE KEY' "$download"; do
      warn "No key at $download."
      ask download "Path to AuthKey_$APP_STORE_CONNECT_KEY_ID.p8 (drag it in from Finder):" || exit 1
      download=$(clean_path "$download")
    done
    (umask 077 && cp "$download" "$key")
    step "Copied it to $key."
  fi
  write_env APP_STORE_CONNECT_KEY_PATH "$key"
  # fastlane's api_key_path: the key itself, as JSON.
  (umask 077 && python3 -I - "$APP_STORE_CONNECT_KEY_ID" "$APP_STORE_CONNECT_ISSUER_ID" "$key" \
    > "$KEY_JSON" <<'PY'
import json, sys
key_id, issuer_id, path = sys.argv[1:]
with open(path) as f:
    print(json.dumps({"key_id": key_id, "issuer_id": issuer_id, "key": f.read(), "in_house": False}))
PY
  )
  step "Wrote fastlane's key file, $KEY_JSON."
  printf '\n'
  say "Make a 1Password item named \"Cassette App Store Connect key\" with:"
  step "the key file attached: $key"
  step "Key ID $APP_STORE_CONNECT_KEY_ID and Issuer ID $APP_STORE_CONNECT_ISSUER_ID"
  command -v open >/dev/null 2>&1 && open -R "$key" && note "Finder shows the key."
  until confirm "Is the item saved in 1Password?"; do
    warn "Apple won't let you download it again; a lost key means revoking it and making another."
  done
  if [[ -n "$download" && -f "$download" ]] && confirm "Delete the copy in $(dirname "$download")?"; then
    rm "$download"
    step "Deleted $download."
  fi
  pause
}

# ── 7 ─────────────────────────────────────────────────────────────────────
s_secrets() {
  stage "GitHub secrets"
  say "CI's TestFlight job reads these; until they're there, it skips the upload."
  if [[ ! -f "$APP_STORE_CONNECT_KEY_PATH" ]]; then
    warn "No key at ${APP_STORE_CONNECT_KEY_PATH:-(none saved)}."
    resume_hint s_api_key
    exit 1
  fi
  local secrets existing
  secrets=$(gh secret list 2>/dev/null | awk '{print $1}' || true)
  existing=$(grep -c '^APP_STORE_CONNECT_' <<< "$secrets" || true)
  if (( existing > 0 )) && ! confirm "The repo has App Store Connect secrets already. Replace them?"; then
    note "Kept the existing secrets."
  else
    set_secret APP_STORE_CONNECT_KEY_ID "$APP_STORE_CONNECT_KEY_ID"
    set_secret APP_STORE_CONNECT_ISSUER_ID "$APP_STORE_CONNECT_ISSUER_ID"
    set_secret APP_STORE_CONNECT_KEY_BASE64 "$(base64 < "$APP_STORE_CONNECT_KEY_PATH" | tr -d '\n')"
  fi
  grep -q '^FIREBASE_IOS_CONFIG_BASE64$' <<< "$secrets" ||
    warn "No FIREBASE_IOS_CONFIG_BASE64, so TestFlight builds won't send crash reports (scripts/firebase-wizard)."
  pause
}

# ── 8 ─────────────────────────────────────────────────────────────────────
s_first_build() {
  stage "The first TestFlight build"
  say "CI's TestFlight job archives main's Release build ($VERSION, numbered by commit count)"
  say "and uploads it. Main's next push does that on its own; this re-runs it on the latest."
  note "It builds with Xcode 27.1 (GitHub's xcode-27 image), so the app fills the iPhone Duo."
  printf '\n'
  local run job uploaded
  run=$(gh run list --workflow build.yml --branch main --event push --status success --limit 1 \
    --json databaseId --jq '.[0].databaseId' 2>/dev/null || true)
  if [[ -z "$run" ]]; then
    warn "There's no successful CI run on main to re-run."
  elif confirm "Re-run the TestFlight job on main's latest CI run ($run)? (20 to 30 minutes)"; then
    job=$(gh run view "$run" --json jobs \
      --jq '.jobs[] | select(.name == "TestFlight") | .databaseId' 2>/dev/null || true)
    if [[ -n "$job" ]] && gh run rerun "$run" --job "$job"; then
      sleep 10
      if gh run watch "$run" --exit-status --interval 30; then
        uploaded=$(gh run view "$run" --json jobs --jq '.jobs[] | select(.name == "TestFlight")
          | .steps[] | select(.name == "Archive and upload") | .conclusion' 2>/dev/null || true)
        if [[ "$uploaded" == success ]]; then
          step "Uploaded. Apple processes it for 10 to 30 minutes, then emails you."
          pause
          return
        fi
        warn "The job ran but skipped the upload: check the secrets ($(stage_number s_secrets))."
      else
        warn "The TestFlight job failed: gh run view $run --log-failed"
      fi
    else
      warn "Couldn't re-run it: gh run view $run"
    fi
  fi
  printf '\n'
  if confirm "Archive and upload from this Mac instead, with its Xcode?"; then
    archive_here || resume_hint s_first_build
  fi
  pause
}

# ── 9 ─────────────────────────────────────────────────────────────────────
s_testers() {
  stage "TestFlight testers"
  open_url "$(app_url)/testflight/ios"
  step "Wait for the build under iOS Builds (Apple emails once it's processed)."
  step "Internal Testing (+): a group named Internal, with you in it, and Enable automatic"
  say "  distribution ticked, so each new build reaches it."
  step "On the iPhone: install TestFlight from the App Store, then accept the invite email."
  step "The watch app comes with it when Watch → General → Automatic App Install is on;"
  say "  otherwise install it from the Watch app's Available Apps."
  note "Internal testers (your team, up to 100) need no review. External testers, by email or a"
  note "public link, need Beta App Review and a feedback email (External Testing)."
  pause "Press Enter once it's installed."
}

# ── 10 ────────────────────────────────────────────────────────────────────
s_try_it() {
  stage "Try it on the bike"
  say "TestFlight's build is the store build. Check what the Simulator can't:"
  step "Wake the bike with the app closed: the batteries and widgets update (background Bluetooth)."
  step "A low component: its alert, and the pre-ride heads-up marked Time Sensitive."
  step "Home Screen and Lock Screen widgets, StandBy, and the Live Activity during a refresh."
  step "Apple Watch: the bike's page, a complication and the Smart Stack card."
  step "The reviewer's route on a fresh install: the steps in"
  say "  fastlane/metadata/ios/review_information/notes.txt, through Demo refresh."
  step "An iPad, if you have one: the dashboard and the bike rail."
  printf '\n'
  say "Then record a short video of the app reading the real bike (a screen recording, or"
  say "film the bike and the phone together). Reviewers have no AXS parts: it goes to App"
  say "Review in stage $(stage_number s_version_page)."
  printf '\n'
  if ! confirm "Does everything work, and do you have the video?"; then
    note "Fix it on main and CI uploads the next build to the Internal group."
    resume_hint s_try_it
    exit 0
  fi
}

# ── 11 ────────────────────────────────────────────────────────────────────
s_listing() {
  stage "Upload the listing"
  say "fastlane uploads the name, subtitle, description, keywords, URLs, categories, review"
  say "notes and screenshots from fastlane/ onto version $VERSION (renaming Apple's 1.0)."
  note "It leaves What's New out on an app's first version."
  if ! command -v fastlane >/dev/null 2>&1; then
    warn "No fastlane: brew install fastlane."
    resume_hint s_listing
    exit 1
  fi
  if [[ ! -f "$KEY_JSON" ]]; then
    warn "No API key file at $KEY_JSON."
    resume_hint s_keep_key
    exit 1
  fi
  printf '\n'
  if confirm "Upload it now? fastlane shows a preview to approve first."; then
    if ! APP_STORE_CONNECT_API_KEY_PATH="$KEY_JSON" DELIVER_APP_VERSION="$VERSION" \
      fastlane ios listing; then
      warn "fastlane stopped; fix what it says."
      resume_hint s_listing
      exit 1
    fi
    step "Uploaded."
  fi
  pause
}

# ── 12 ────────────────────────────────────────────────────────────────────
s_privacy() {
  stage "App privacy"
  say "Crash data and other diagnostic data, not linked to the person, no tracking (decision"
  say "0020), from fastlane/app_privacy_details.json. Apple has no API key route for these,"
  say "so fastlane signs in with your Apple ID: its password, then a two-factor code."
  printf '\n'
  until ask APPLE_ID "Your Apple ID (an email):" || exit 1; [[ "$APPLE_ID" == *@* ]]; do
    warn "It's the email you sign in to App Store Connect with."
  done
  write_env APPLE_ID "$APPLE_ID"
  if confirm "Upload and publish the privacy answers now?"; then
    if ! fastlane ios privacy "username:$APPLE_ID"; then
      warn "fastlane stopped; fix what it says."
      resume_hint s_privacy
      exit 1
    fi
    step "Published."
  fi
  pause
}

