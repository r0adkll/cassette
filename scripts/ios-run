#!/usr/bin/env bash
# Builds the iOS app's debug build and runs it (decision 0017).
#
#   scripts/ios-run            $IOS_SIMULATOR (a UDID), else the booted Simulator, else boots
#                              $SIMULATOR (default "iPhone 16 Pro")
#   scripts/ios-run --device   the first connected iPhone, or $IOS_DEVICE (a devicectl identifier)
#
# Bluetooth only works on an iPhone; the Simulator shows the UI.
set -euo pipefail
cd "$(dirname "$0")/.."

project=app/ios/Cassette/Cassette.xcodeproj
derived=app/ios/Cassette/build
bundle=com.r0adkll.cassette.debug

scripts/xcodegen

if [ "${1:-}" = "--device" ]; then
  if [ -z "${IOS_DEVICE:-}" ]; then
    json=$(mktemp)
    xcrun devicectl list devices --json-output "$json" >/dev/null
    IOS_DEVICE=$(python3 -I -c '
import json, sys
devices = json.load(open(sys.argv[1]))["result"]["devices"]
for d in devices:
    if d["hardwareProperties"].get("platform") == "iOS" and d["connectionProperties"].get("tunnelState") != "unavailable":
        print(d["identifier"]); break
' "$json")
    rm -f "$json"
  fi
  [ -n "$IOS_DEVICE" ] || { echo "No iPhone connected" >&2; exit 1; }
  xcodebuild -project "$project" -scheme Cassette -configuration Debug \
    -destination 'generic/platform=iOS' -derivedDataPath "$derived" -allowProvisioningUpdates \
    -quiet build
  xcrun devicectl device install app --device "$IOS_DEVICE" \
    "$derived/Build/Products/Debug-iphoneos/Cassette.app"
  xcrun devicectl device process launch --terminate-existing --device "$IOS_DEVICE" "$bundle"
else
  # Simulators are shared with other sessions: pass $IOS_SIMULATOR (a UDID) to use your own.
  if [ -n "${IOS_SIMULATOR:-}" ]; then
    booted=$IOS_SIMULATOR
    xcrun simctl bootstatus "$booted" -b >/dev/null
  else
    booted=$(xcrun simctl list devices booted | grep -Eo '[0-9A-F-]{36}' | head -1 || true)
  fi
  if [ -z "$booted" ]; then
    xcrun simctl boot "${SIMULATOR:-iPhone 16 Pro}"
    booted=$(xcrun simctl list devices booted | grep -Eo '[0-9A-F-]{36}' | head -1)
  fi
  open -a Simulator
  xcodebuild -project "$project" -scheme Cassette -configuration Debug \
    -destination "platform=iOS Simulator,id=$booted" -derivedDataPath "$derived" -quiet build
  xcrun simctl install "$booted" "$derived/Build/Products/Debug-iphonesimulator/Cassette.app"
  xcrun simctl launch --terminate-running-process "$booted" "$bundle"
fi
