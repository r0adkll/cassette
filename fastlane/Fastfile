# Store listings only, for now: text and images, no builds (README.md here). The Play bundle and
# App Store build lanes come with the release CI job.

platform :android do
  desc "Uploads the Play listing (text and images) from metadata/android"
  lane :listing do
    upload_to_play_store(
      package_name: "com.r0adkll.cassette",
      metadata_path: "fastlane/metadata/android",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
    )
  end
end

platform :ios do
  desc "Uploads the App Store listing (text and screenshots) from metadata/ios and screenshots/ios"
  lane :listing do
    upload_to_app_store(
      app_identifier: "com.r0adkll.cassette",
      metadata_path: "fastlane/metadata/ios",
      screenshots_path: "fastlane/screenshots/ios",
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
    )
  end

  # Decision 0020: crash data and other diagnostic data, not linked, not tracking. Apple has no API
  # key route for these, so it signs in with an Apple ID (an owner or admin of the team).
  desc "Uploads and publishes the App Store privacy answers from app_privacy_details.json"
  lane :privacy do |options|
    upload_app_privacy_details_to_app_store(
      app_identifier: "com.r0adkll.cassette",
      username: options[:username],
      json_path: "fastlane/app_privacy_details.json",
    )
  end
end
