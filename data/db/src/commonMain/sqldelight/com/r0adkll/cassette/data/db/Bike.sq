CREATE TABLE bike (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    -- BikeType name
    type TEXT NOT NULL,
    photo_path TEXT,
    -- The hub it was added with; every system's hub, this one included, is in `hub` (decision 0028).
    hub_serial INTEGER UNIQUE,
    -- epoch milliseconds
    created_at INTEGER NOT NULL,
    last_seen_at INTEGER,
    -- When one of its hubs' battery tables was last read (each hub's own time is in `hub`).
    hub_read_at INTEGER
);

-- Most recently seen first: the default bike (decision 0010).
selectAll:
SELECT * FROM bike ORDER BY last_seen_at IS NULL, last_seen_at DESC, id;

selectById:
SELECT * FROM bike WHERE id = ?;

selectByHubSerial:
SELECT * FROM bike WHERE hub_serial = ?;

insert:
INSERT INTO bike (name, type, photo_path, hub_serial, created_at, last_seen_at)
VALUES (?, ?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

updateDetails:
UPDATE bike SET name = :name, type = :type, photo_path = :photoPath WHERE id = :id;

markSeen:
UPDATE bike SET last_seen_at = max(coalesce(last_seen_at, 0), :at) WHERE id = :id;

markHubRead:
UPDATE bike SET hub_read_at = :at WHERE id = :id;

-- After its first system is removed, the bike is known by another.
setHubSerial:
UPDATE bike SET hub_serial = :hubSerial WHERE id = :id;

delete:
DELETE FROM bike WHERE id = ?;
